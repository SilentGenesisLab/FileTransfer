generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique @db.VarChar(20)
  role        UserRole @default(USER)
  nickname    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  transfers   Transfer[]
}

model Transfer {
  id          String   @id @default(cuid())
  pickupCode  String   @unique @db.VarChar(6)
  type        TransferType
  textContent String?  @db.Text
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  files       File[]

  @@index([pickupCode])
  @@index([userId])
}

model File {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fileName   String
  fileSize   Int
  ossKey     String
  ossUrl     String
  createdAt  DateTime @default(now())

  @@index([transferId])
}

enum TransferType {
  FILE
  TEXT
}

enum UserRole {
  ADMIN
  USER
}
